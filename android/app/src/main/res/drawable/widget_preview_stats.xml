<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Card Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1B1626"
                android:centerColor="#13101C"
                android:endColor="#0C0B12"
                android:angle="135" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#362C4C" />
        </shape>
    </item>

    <!-- Header Accent Bar -->
    <item
        android:top="14dp"
        android:left="16dp"
        android:width="100dp"
        android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF4081" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- 3 Stat Blocks -->
    <!-- Stat 1 -->
    <item
        android:top="32dp"
        android:bottom="38dp"
        android:left="14dp"
        android:width="42dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F1A2C" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#322846" />
        </shape>
    </item>

    <!-- Stat 2 -->
    <item
        android:top="32dp"
        android:bottom="38dp"
        android:left="62dp"
        android:width="42dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F1A2C" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#322846" />
        </shape>
    </item>

    <!-- Stat 3 -->
    <item
        android:top="32dp"
        android:bottom="38dp"
        android:left="110dp"
        android:width="42dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F1A2C" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#322846" />
        </shape>
    </item>

    <!-- Bottom Top Track Bar -->
    <item
        android:bottom="10dp"
        android:left="14dp"
        android:right="14dp"
        android:height="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F1A2C" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#322846" />
        </shape>
    </item>
</layer-list>

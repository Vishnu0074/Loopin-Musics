<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_live_dot"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="NOW PLAYING"
            android:textColor="#FFFF6FA8"
            android:textSize="10sp"
            android:letterSpacing="0.16"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOOPIN"
            android:textColor="#66FFFFFF"
            android:textSize="9sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_np_art"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/widget_card_bg"
            android:padding="15dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_music" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_np_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Nothing Playing"
                android:textColor="#FFF8F7FA"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_np_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Choose something you love"
                android:textColor="#FFAAA3AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#18FFFFFF"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_np_prev"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous track"
            android:padding="10dp"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_np_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/widget_play_btn_bg"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_np_next"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next track"
            android:padding="10dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>